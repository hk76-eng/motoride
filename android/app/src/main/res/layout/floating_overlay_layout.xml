<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="6dp">

    <!-- Circular Floating Icon Container -->
    <FrameLayout
        android:id="@+id/floating_icon_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_overlay"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp">

        <ImageView
            android:id="@+id/floating_logo_image"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:contentDescription="MotoRide Floating Overlay"
            android:src="@drawable/ic_motoride_floating" />

        <!-- Tiny Pulse / Active Badge -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_floating_overlay" />
    </FrameLayout>
</FrameLayout>
